# ==========================================
# Variables de entorno
# En local: se leen de este archivo (dotenv).
# En Render: NO se sube este archivo. Se configuran en
#   Dashboard -> tu servicio -> Environment
# Render las inyecta como variables de entorno reales y el proceso
# las lee igual, asi que los nombres de abajo deben coincidir.
# ==========================================

# URL publica de la aplicacion, sin slash final.
# OBLIGATORIA en produccion: si falta, el fallback es localhost:8000 y
# los links de Stripe y los correos de verificacion apuntan a tu laptop.
BASE_URL="http://localhost:8000"

# ==========================================
# Supabase (PostgreSQL)
# Obtener desde: https://app.supabase.com/project/_/settings/api
# ==========================================
SUPABASE_URL="https://xxxxx.supabase.co"

# El backend usa la SERVICE ROLE key a proposito: la app hace su propio login
# (bcrypt + tabla 'sesiones') y no usa Supabase Auth, asi que las RLS solo
# estorban (bloquean los INSERT y ocultan filas en los SELECT).
# Esta clave NUNCA debe exponerse al frontend ni usarse en URLs publicas.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxx"

# ==========================================
# Envio de emails
#
# Elige UN proveedor. El codigo toma el que encuentre primero:
# si hay BREVO_API_KEY usa Brevo, si no usa Resend. Sin ninguna de las dos
# claves los correos se imprimen en consola (modo desarrollo), y en ese modo
# los enlaces de verificacion NO llegan a nadie.
# ==========================================

# --- Brevo (recomendado mientras no haya dominio propio) ---------------
# Brevo deja verificar una direccion suelta con un clic, sin comprar dominio.
# Pasos: Brevo -> Transactional > Senders -> Add a new sender, confirmar el
# correo que llega. Despus se elige una de las dos vias de abajo.

# Via Gmail propio (la unica que no pide cuenta en ningun proveedor ni dominio).
# Requisitos en la cuenta de Google: activar verificacion en dos pasos y generar
# una contrasena de aplicacion en
# myaccount.google.com/apppasswords. OJO: la verificacion en dos pasos se puede
# hacer con la app Google Authenticator, sin necesidad de un numero de telefono.
#
# ADVERTENCIA: comodo para desarrollo, NO apto para produccion. Google corta el
# envio si detecta volumen anomalo o riesgo de compromiso, y queda atado a una
# cuenta personal.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT="465"

# Via SMTP de Brevo (la mas comoda si ya tenes la cuenta verificada): en Smtp & API
# aparece el login siempre visible y
# la password se revela al pulsar "Open SMTP key settings". El login es un
# identificador de Brevo del tipo algo@smtp-brevo.com, NO el correo remitente.
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_LOGIN=""
BREVO_SMTP_PASSWORD=""

# Via API: Smtp & API > API Keys > Generate a new API key. La clave se muestra
# una sola vez, al crearla; despues ya no se puede volver a ver.
BREVO_API_KEY=""

# Remitente. Tiene que ser el mismo correo que verificaste en Senders.
BREVO_SENDER_NAME="Precarga"
BREVO_SENDER_EMAIL=""

# --- Resend (exige dominio verificado) ----------------------------------
# Resend NO acepta un remitente @gmail.com ni un subdominio de Render: solo
# dominios propios verificados con registros DNS. Sin eso responde 403.
RESEND_API_KEY=""
FROM_EMAIL="Precarga <noreply@tudominio.com>"

# ==========================================
# Stripe
# Obtener desde: https://dashboard.stripe.com/apikeys
# El webhook debe apuntar a {BASE_URL}/api/payments/webhook
# ==========================================
STRIPE_SECRET_KEY="sk_test_pendiente"
STRIPE_PUBLISHABLE_KEY="pk_test_pendiente"
STRIPE_WEBHOOK_SECRET="whsec_pendiente"
# Precio del plan en pesos (se convierte a centavos internamente)
STRIPE_PLAN_PRICE="499.00"
STRIPE_PLAN_DAYS="7"
STRIPE_CURRENCY="mxn"