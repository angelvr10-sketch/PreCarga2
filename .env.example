# URL base de tu aplicacion (sin slash final)
BASE_URL="http://localhost:8000"

# ==========================================
# Supabase (PostgreSQL)
# Obtener desde: https://app.supabase.com/project/_/settings/api
# ==========================================
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_KEY="sb_publishable_xxxxx"

# ==========================================
# Configuracion de Email (SMTP)
# Usa Gmail, SendGrid, Mailgun, etc.
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-email@gmail.com"
SMTP_PASSWORD="tu-app-password"  # Para Gmail, usar App Password
FROM_EMAIL="Precarga SHAT <noreply@precargashat.com>"

# ==========================================
# Configuracion de Stripe
# Obtener desde: https://dashboard.stripe.com/apikeys
# ==========================================
