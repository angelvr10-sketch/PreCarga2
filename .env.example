# ==========================================
# Variables de entorno
# En local: se leen de este archivo (dotenv).
# En Render: NO se sube este archivo. Se configuran en
#   Dashboard -> tu servicio -> Environment
# Render las inyecta como variables de entorno reales y el proceso
# las lee igual, asi que los nombres de abajo deben coincidir.
# ==========================================

# URL publica de la aplicacion, sin slash final.
# OBLIGATORIA en produccion: si falta, el fallback es localhost:8000 y
# los links de Stripe y los correos de verificacion apuntan a tu laptop.
BASE_URL="http://localhost:8000"

# ==========================================
# Supabase (PostgreSQL)
# Obtener desde: https://app.supabase.com/project/_/settings/api
# ==========================================
SUPABASE_URL="https://xxxxx.supabase.co"

# El backend usa la SERVICE ROLE key a proposito: la app hace su propio login
# (bcrypt + tabla 'sesiones') y no usa Supabase Auth, asi que las RLS solo
# estorban (bloquean los INSERT y ocultan filas en los SELECT).
# Esta clave NUNCA debe exponerse al frontend ni usarse en URLs publicas.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxx"

# ==========================================
# Envio de emails (Resend)
# Sin RESEND_API_KEY los correos se imprimen en consola (modo desarrollo),
# los enlaces de verificacion NO llegan a nadie y no se puede publicar.
# ==========================================
RESEND_API_KEY="re_xxxxxxxxxxxx"
FROM_EMAIL="Precarga <noreply@tudominio.com>"

# ==========================================
# Stripe
# Obtener desde: https://dashboard.stripe.com/apikeys
# El webhook debe apuntar a {BASE_URL}/api/payments/webhook
# ==========================================
STRIPE_SECRET_KEY="sk_test_pendiente"
STRIPE_PUBLISHABLE_KEY="pk_test_pendiente"
STRIPE_WEBHOOK_SECRET="whsec_pendiente"
# Precio del plan en pesos (se convierte a centavos internamente)
STRIPE_PLAN_PRICE="499.00"
STRIPE_PLAN_DAYS="7"
STRIPE_CURRENCY="mxn"