# ==========================================
# Configuracion de MercadoPago
# Obtener desde: https://www.mercadopago.com.mx/developers/panel
# ==========================================

# Credenciales
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Webhook secret (opcional, para validacion adicional)
MERCADOPAGO_WEBHOOK_SECRET="tu-secreto-webhook-aqui"

# Configuracion de Plan
MERCADOPAGO_PLAN_PRICE="499.00"
MERCADOPAGO_PLAN_DAYS="7"
MERCADOPAGO_CURRENCY="MXN"

# ==========================================
# Configuracion de Stripe
# Obtener desde: https://dashboard.stripe.com/apikeys
# ==========================================

# Clave secreta (server-side)
STRIPE_SECRET_KEY="sk_test_pendiente"

# Clave publica (client-side)
STRIPE_PUBLISHABLE_KEY="pk_test_pendiente"

# Webhook secret (para verificar firmas)
# Obtener desde: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_pendiente"

# Configuracion de Plan Stripe
STRIPE_PLAN_PRICE="499.00"
STRIPE_PLAN_DAYS="7"
STRIPE_CURRENCY="mxn"

# ==========================================
# URL base de tu aplicacion (cambiar en produccion)
# ==========================================
BASE_URL="http://localhost:8000"
